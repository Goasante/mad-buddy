.dev-server.pid
tmp/

# Firebase config — contains API keys. Keep local; each dev/CI supplies their
# own. Remove these lines if you deliberately commit them (private repo).
android/app/google-services.json
ios/App/App/GoogleService-Info.plist

# Local dev logs. Written by `next dev` runs and never worth committing.
*.dev.log
.codex-dev.*
.stage*-dev.log

# Downloaded tooling binaries. Large, machine-specific, and reproducible from
# the vendor — an installer in git is 40MB every clone pays for forever.
assets/*.exe
assets/*.dmg
assets/*.zip

# Local QA reproduction harness. Scripts that drive the running app against a
# local Supabase stack, plus the cached session tokens they reuse. Never part
# of a build, and .qa-auth-cache.json holds real access tokens.
qa-*.mjs
qa-*.json
qa-shots/
.qa-auth-cache.json

# Hardening program runtime artifacts (screenshots, captured auth state).
# Never commit: .hardening/auth-*.json contains a real session token.
.hardening/

# Added by `vercel link`, and kept: it is stricter than the entries above and
# catches any .env variant a future tool might create. `.env.example` is
# already tracked, so this does not hide it.
.env*
.phasea.json

# Local visual-verification output (see scripts/shoot-event-rooms.mjs).
/screenshots/

# Written by `next dev` (16.3.x+), not by us: it generates an agent-instruction
# AGENTS.md at the repo root and a CLAUDE.md that just points at it, and re-adds
# them if deleted. See node_modules/next/dist/server/lib/generate-agent-files.js.
# Neither filename has ever been committed here, so anchoring to the root keeps
# a real one elsewhere in the tree visible.
/AGENTS.md
/CLAUDE.md

# Supabase CLI workspace state (generated, machine-local).
#
# NOT a secret -- a project ref is not a password -- but committing it is an
# OPERATIONAL hazard: it makes every clone of this repository arrive already
# linked to the production project, so `supabase db reset` / `db push` in a
# worktree that looks local can target production. It also churns on every
# CLI version bump. Supabase's own repositories ignore it for the same reason.
#
# Each person links their own workspace with:
#   supabase link --project-ref <ref>
supabase/.temp/
**/supabase/.temp/
# Staging seed manifest: synthetic ids, machine-specific, never committed.
staging-manifest.local.json
