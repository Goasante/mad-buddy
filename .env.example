# Mad Buddy environment template
#
# Copy to .env.local for local web development and fill only the values needed
# for the feature you are exercising. Never commit real secret values.
#
# Anything prefixed NEXT_PUBLIC_ is shipped to the browser and MUST NOT contain
# a privileged credential.

# -----------------------------------------------------------------------------
# Supabase
# -----------------------------------------------------------------------------
# Public/browser configuration.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server/operator secrets. Never expose to browser/native clients.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=
# CLI/direct-database operator use only; not a browser/server feature flag.
SUPABASE_DB_PASSWORD=

# -----------------------------------------------------------------------------
# Mad Buddy Access / Paystack
# -----------------------------------------------------------------------------
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=
PAYSTACK_SECRET_KEY=
PAYSTACK_WEBHOOK_SECRET=

# Current Mad Buddy Access product authority lives in lib/access/product.ts.
# These are OPTIONAL overrides for test/staging; Production has source defaults.
MAD_BUDDY_ACCESS_AMOUNT_MINOR=
MAD_BUDDY_ACCESS_PLAN_CODE=

# LEGACY ONLY — retired Buddy Plus / Buddy Pro checkout paths still contain
# references while cleanup is in progress. Do not treat these as current product
# authority and do not add new features against them.
PAYSTACK_BUDDY_PLUS_PLAN_CODE=
PAYSTACK_BUDDY_PRO_PLAN_CODE=

# -----------------------------------------------------------------------------
# App / admin / analytics
# -----------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=
NEXT_PUBLIC_GA_MEASUREMENT_ID=
ADMIN_EMAILS=

# Optional extra allowed origin for the bundled/mobile client during controlled
# development/deployment. Browser/native client values remain public.
MOBILE_ALLOWED_ORIGIN=

# -----------------------------------------------------------------------------
# Background jobs / schedulers
# -----------------------------------------------------------------------------
# GitHub Actions recovery backstop credential.
CRON_SECRET=
# Supabase pg_cron primary scheduler credential. Keep independent from
# CRON_SECRET so either scheduler can be rotated/revoked on its own.
CRON_DB_SECRET=

# -----------------------------------------------------------------------------
# Cloudflare Turnstile
# -----------------------------------------------------------------------------
# Site key is public; secret is server-only.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# -----------------------------------------------------------------------------
# Web push
# -----------------------------------------------------------------------------
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# -----------------------------------------------------------------------------
# Native push (FCM/APNs through Firebase Admin)
# -----------------------------------------------------------------------------
# Base64-encoded Firebase service-account JSON. Contains a private key.
# SERVER ONLY — never put this in mobile/.env.local or any VITE_/NEXT_PUBLIC_ var.
FIREBASE_SERVICE_ACCOUNT_BASE64=

# -----------------------------------------------------------------------------
# Contact discovery privacy
# -----------------------------------------------------------------------------
# Server-only HMAC key. Must be at least 32 characters.
CONTACT_MATCH_HMAC_SECRET=
# When rotating, versioned keys use CONTACT_MATCH_HMAC_SECRET_V2, _V3, etc.
# Keep older versions while stored identifiers still depend on them.
