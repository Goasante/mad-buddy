# Release signing for the Mad Buddy Android app.
#
# Copy this file to `android/keystore.properties` (which is gitignored — the
# real file and the keystore must NEVER be committed) and fill in the values
# for your release keystore.
#
# Generate a release keystore once (keep it and these passwords safe — losing
# the key means you can never ship an update that upgrades the same install):
#
#   keytool -genkey -v -keystore mad-buddy-release.jks \
#     -keyalg RSA -keysize 2048 -validity 10000 -alias mad-buddy
#
# Then build a signed release APK/AAB. NOTE: the Android app bundles
# mobile/dist (the Vite SPA), NOT the root Next.js app, so build in mobile/:
#
#   cd mobile && npm run build   # produces mobile/dist (Vite)
#   cd .. && npx cap sync android
#   cd android && ./gradlew assembleRelease   # signed APK (bundleRelease for AAB)
#   # Windows PowerShell: use .\gradlew.bat instead of ./gradlew

storeFile=/absolute/path/to/mad-buddy-release.jks
storePassword=CHANGE_ME
keyAlias=mad-buddy
keyPassword=CHANGE_ME
